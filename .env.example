DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

NEXTAUTH_SECRET="randomly_generated_secret_key"
NEXTAUTH_URL="http://localhost:3000"

NODE_ENV=development

DEV_DATABASE_URL=
DEV_REDIS_URL=

DATABASE_URL=
# Must be the same Redis instance the bot writes bot_status heartbeats to.
REDIS_URL=redis://redis:6379
# Remote database over TLS with a certificate that is not publicly trusted (Cloudflare Origin CA):
# the CA to trust, as PEM text, PEM with \n instead of line breaks, or base64. Leave empty otherwise.
# DATABASE_SSL_CA=
# REDIS_TLS_CA=

# Discord ids that may open /admin (comma separated).
ADMIN_USER_IDS=

# Optional: protects /api/status/check so only your scheduler can call it.
STATUS_CRON_SECRET=
