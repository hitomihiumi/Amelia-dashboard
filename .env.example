DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

NEXTAUTH_SECRET="randomly_generated_secret_key"
NEXTAUTH_URL="http://localhost:3000"

NODE_ENV=development

DEV_DATABASE_URL=
DEV_REDIS_URL=

DATABASE_URL=
